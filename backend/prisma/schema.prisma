generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique // Could be ABHA ID or phone number
  passwordHash String
  role         String   @default("ROLE_CITIZEN") // CITIZEN, ASHA, ANM, CHO, DOCTOR_MO, SPECIALIST, etc.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
